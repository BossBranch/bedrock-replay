{
  "name": "bedrock-server-replay",
  "version": "1.1.0",
  "private": true,
  "description": "Bedrock Server Replay — PC launcher for server replay hub",
  "author": "Bedrock Server Replay",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.bedrock.serverreplay",
    "productName": "Bedrock Server Replay",
    "copyright": "MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "hub/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../node_modules",
        "to": "hub/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../package.json",
        "to": "hub/package.json"
      },
      {
        "from": "../config.example.json",
        "to": "hub/config.example.json"
      },
      {
        "from": "../data",
        "to": "hub/data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/avatar.png",
      "artifactName": "Bedrock-Server-Replay-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bedrock Server Replay",
      "uninstallDisplayName": "Bedrock Server Replay",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asar": true
  }
}
